{
  "name": "rosse-catalog-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.rossetienda.online",
      "custom_domain": true
    },
    {
      "pattern": "rossetienda.online/*",
      "zone_name": "rossetienda.online"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rosse-catalog",
      "database_id": "12d51a09-5815-4a6d-a0f2-c289373d5c7f"
    },
    {
      "binding": "REGISTRO",
      "database_name": "registro-usuarios",
      "database_id": "1a70f909-ce72-4b38-b0bc-61a22ad1a005"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "rosse-catalog-photos"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "7031",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
